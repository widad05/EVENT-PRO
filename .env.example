# GEMINI_API_KEY: Required for Gemini AI API calls if AI extensions are added.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this applet or Cloudflare Pages deployment is hosted.
APP_URL="MY_APP_URL"

# Cloudflare Turnstile (optional spam protection; leave empty in local preview or configure keys in Cloudflare)
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=

# Admin security passcode override (optional; if empty, first-run inline admin setup secures the initial admin account)
ADMIN_PASSCODE=

# Google Maps Platform API key for the Discover Casablanca interactive map
VITE_GOOGLE_MAPS_API_KEY=

